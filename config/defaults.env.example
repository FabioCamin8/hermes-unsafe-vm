# Guest/runtime configuration. Copy to an untracked local file before use.
HERMES_USER=hermes
HERMES_CDP_PORT=9222
HERMES_VISIBLE_CHROMIUM=true
ENABLE_AUTOLOGIN=true

# The installer is fetched over HTTPS and checked before execution.
HERMES_INSTALLER_URL=https://hermes-agent.nousresearch.com/install.sh
HERMES_INSTALLER_SHA256=c0380bc1f78d3d662a77663ce20cc17e14cbc4bec35e61ab7a33bac5f3afed2d
HERMES_COMMIT=a9611f3c6f7ff287a4f10f71a77d7c5a808ea1c8

# The VM consumes the public immutable v0.1.0 revision.
HERMES_AUTONOMY_REPO=https://github.com/FabioCamin8/hermes-unsafe-autonomy.git
HERMES_AUTONOMY_VERSION=v0.1.0
HERMES_AUTONOMY_COMMIT=3faa738f1699d24f9d9e8d767b1844d945235521
CHROME_DEVTOOLS_MCP_VERSION=1.8.0
CODEX_VERSION=0.150.1

# Empty means SSH is allowed from reachable networks; set one or both values
# to narrow inbound SSH without affecting outbound package/web access.
SSH_ALLOWED_CIDR=
SSH_ALLOWED_IPV6_CIDR=
