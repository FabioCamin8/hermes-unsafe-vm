# Private operator file for cloning one project-created Proxmox template.
TEMPLATE_VMID=
TEMPLATE_NAME=
CLONE_VMID=
CLONE_NAME=hermes-unsafe-vm-clone
CLONE_STORAGE=
SSH_USER=hermes
SSH_HOST=
SSH_KEY_FILE=
SSH_PUBLIC_KEY_FILE=
GUEST_REPO=/root/hermes-unsafe-vm
# This must be the private source evidence file produced by convert-template.sh.
SOURCE_EVIDENCE_FILE=/tmp/hermes-unsafe-vm-template-source
START_VM=1
