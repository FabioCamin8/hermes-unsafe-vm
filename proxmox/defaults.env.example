# Run proxmox/create-vm.sh on the selected Proxmox node after filling these.
VMID=
VM_NAME=hermes-unsafe-vm
STORAGE=
BRIDGE=vmbr0
VLAN_ID=
MTU=1500
CPU_TYPE=host
CORES=4
MEMORY_MB=8192
DISK_SIZE_GB=40
MACHINE=q35
BIOS=ovmf
CI_USER=hermes
SSH_PUBLIC_KEY_FILE=
IPCONFIG0=ip=dhcp
CIUPGRADE=0
IMAGE_URL=https://cloud.debian.org/images/cloud/trixie/20260826-2582/debian-13-genericcloud-amd64-20260826-2582.qcow2
IMAGE_CHECKSUM_URL=https://cloud.debian.org/images/cloud/trixie/20260826-2582/SHA512SUMS
IMAGE_CACHE_DIR=/var/lib/vz/template/cache
START_VM=0
